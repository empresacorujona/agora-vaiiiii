# App / sessões
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
FLASK_DEBUG=false
APP_BASE_URL=http://localhost:5000
DATABASE_URL=postgresql+psycopg2://postgres:SUA_SENHA@localhost:5432/convenio_db
EMAIL_VERIFICATION_MAX_AGE=86400

# Banco local (padrão SQLite). Para PostgreSQL, informe DATABASE_URL.
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/convenio_db

# SMTP de envio de confirmação de e-mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app
MAIL_DEFAULT_SENDER=seu-email@gmail.com

# Mercado Pago Checkout Pro e assinatura do Webhook
MERCADOPAGO_ACCESS_TOKEN=APP_USR-ou-TEST
MERCADOPAGO_WEBHOOK_SECRET=segredo-gerado-no-painel-de-webhooks
